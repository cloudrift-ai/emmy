# The pinned serving config for deepseek-ai/DeepSeek-V4-Flash-0731 on the 16x V100 SXM3 host — the SINGLE
# source for the golden's twin widths, the warm run, the baked image ENV/CMD, and the verify run. Same syntax
# rules as every file here: `VAR=value`, one per line, double quotes around any value containing spaces.
#
# WHY THIS FILE EXISTS (2026-09-09). Until now this model had no pinned config, so its serving twins were
# captured with `scripts/capture_gen_twins.py`'s own defaults — decode bucket 32 — while `emmy serve` deploys
# `EMMY_GEN_DECODE_BUCKET`'s default of 16. The two numbers live in different files and nothing compared them.
# The result: a full measurement round recorded routes for widths the server never runs, the deployed decode
# kernels resolved from the prior instead, and the boot roofline audit measured the m16 post program at over
# an hour per run — 16 GPUs spent six hours inside one timing loop and the boot never finished. Reading both
# widths from this one file is what stops that class of drift.
#
# The envelope is the one gate (c) booted at (2026-08-26, re-run 2026-09-09): TP8 x PP2 over 43 layers,
# eager execution, fp8 KV, block size 256. The revision is pinned because the fork's expert allocation
# metadata — which decides whether the expert twins spell @mxfp4 or @f8e4m3 — lives in the checkpoint.
SERVE_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
SERVE_REVISION=7872f01b1d1fe23eabc4c98b48bffcef5a386062
# Canonical compiler evidence for this exact model/GPU release envelope. Trace, tune, eval and the image
# gate all read this path from the same config.
SERVE_GOLDEN_FILE=recipes/DeepSeek-V4-Flash-0731/golden/v100_sm70.json
SERVE_MAX_MODEL_LEN=4096
# 4096 prefill capacity + the 16-row decode bucket = the rider headroom vLLM profiles at. The profiling run
# executes at exactly this width, so a twin missing here is a program that only ever appears at boot.
SERVE_MAX_NUM_BATCHED_TOKENS=4112
SERVE_PREFILL_CAPACITY=4096
SERVE_PREFILL_BUCKET=4096
# 16 = the `EMMY_GEN_DECODE_BUCKET` default this deployment runs at. Declared rather than left implicit so
# the captured twins and the deployed programs cannot disagree again.
SERVE_DECODE_BUCKET=16
# 0.90: the plugin's device residents (embed table + norm) are claimed BEFORE vLLM profiling, and at 43
# layers over two pipeline stages this leaves ~13 GiB per card for KV — the measured pool is 67,926 tokens
# on the PP0 stage and 70,049 on PP1.
SERVE_GPU_MEM_UTIL=0.90
# The card the golden is recorded on. Every cache-key input is card-specific, so a warm on a different GPU
# bakes a cache the released image can never hit — warm.sh and verify.sh refuse to run on a mismatch.
SERVE_GPU="NVIDIA Tesla V100 SXM3 32GB"
# The serving envelope every strict boot of this file ran (2026-09-26/27, boot47-51): tensor 8 x pipeline 2
# over mp workers, an fp8 KV cache in 256-token blocks and the checkpoint's own tokenizer mode. Each rank
# holds a 1/8 slice of every routed expert, so single-token decode rides the fixed-slot expert tier and is
# captured as one CUDA graph per step (2026-10-01, boot72: 134 -> 119 ms per output token); wider steps
# run eager, which is why the ladder stops at 1.
SERVE_EXTRA_ARGS="--tensor-parallel-size 8 --pipeline-parallel-size 2 --distributed-executor-backend mp --kv-cache-dtype fp8 --block-size 256 --tokenizer-mode deepseek_v4"
SERVE_CAPTURE_SIZES=[1]
# Off: single-token pre and post programs pad to the width-16 twins, because the M=1 post twin has no route
# that elects under strict evidence, and with the tier on the release gate fails. The M=1 EXPERT program is
# built either way (the fixed-slot tier runs it) and has its rows.
SERVE_M1_TIER=0
# The 1Cat fork's TurboMind switches its recipe sets (the image bakes the others), and strict evidence: a
# twin whose fork no row decides refuses and falls back to the next width (today the M=256 expert twin)
# instead of freezing the prior's pick into the pack.
SERVE_ENV="VLLM_SM70_FP8_TURBOMIND=1 VLLM_SM70_MXFP4_TURBOMIND=1 VLLM_SM70_MXFP4_TUNE_SMALL_SHAPES=0 VLLM_SM70_QUANT_BACKEND=turbomind EMMY_STRICT_EVIDENCE=1"
# The runtime is the pinned 1Cat Volta fork (vLLM 1.2.3 at d76126608, CUDA 12.9), by digest: the plain
# image builds FROM it and the serving image is published as vllm-emmy-<slug>:1.2.3-<emmy sha>.
SERVE_BASE_IMAGE=cloudriftai/1cat-vllm-deepseek-v4-flash-0731@sha256:276240257b224097876b5b6db8f0d32484dff6a6f168d6b03d6df188e5c65bc1
SERVE_RUNTIME_VERSION=1.2.3
