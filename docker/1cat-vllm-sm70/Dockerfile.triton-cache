# syntax=docker/dockerfile:1.7

# Add the target card's JIT caches (Triton, TorchInductor, TileLang, FlashInfer) to an already pinned 1Cat serving
# image. The build context holds `cache/`, a tree rooted at `/` with the files a warm container wrote under its cache
# folders. TRITON_CACHE_DIR is fixed: while it is unset, TorchInductor points Triton at its own folder when its first
# kernel loads, so the folder a kernel lands in depends on what the boot compiled before it, and a boot that loads its
# graphs from the cache looks somewhere else than the cold boot that wrote them. Every Triton entry of the warm
# therefore goes under /root/.triton/cache, merged from wherever it was written (entries are named by content hash).
# JIT_CACHE_MANIFEST_SHA256 is the sha256 of the sorted `sha256sum` listing of `cache/`.
#
#   docker build -f Dockerfile.triton-cache \
#     --build-arg BASE_IMAGE=<the unbaked 1Cat image> \
#     --build-arg JIT_CACHE_MANIFEST_SHA256=<sha256 of the cache manifest> \
#     --build-arg PUBLISH_VERSION=<runtime version> \
#     --build-arg PUBLISH_REVISION=<fork commit> \
#     --build-arg MODEL=<HF model id> \
#     --build-arg MODEL_REVISION=<checkpoint commit> \
#     -t cloudriftai/1cat-vllm-<model-slug>:<runtime-version>-<source-sha> .
#
# DeepSeek V4's bake (1.2.3-d76126608) wrote three folders; in this layout they are cache/root/.triton/cache,
# cache/root/.tilelang/cache and cache/root/.cache/tilelang.

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG JIT_CACHE_MANIFEST_SHA256
ARG PUBLISH_FAMILY=1cat-vllm
ARG PUBLISH_VERSION
ARG PUBLISH_REVISION
ARG MODEL
ARG MODEL_REVISION
COPY --chown=root:root cache/ /

ENV TRITON_CACHE_DIR=/root/.triton/cache \
    TILELANG_CACHE_DIR=/root/.tilelang/cache

LABEL ai.vllm.jit-cache.manifest-sha256="${JIT_CACHE_MANIFEST_SHA256}" \
      ai.vllm.jit-cache.target="NVIDIA Tesla V100 SXM3 32GB" \
      ai.emmy.publish.family="${PUBLISH_FAMILY}" \
      ai.emmy.model.id="${MODEL}" \
      ai.emmy.model.revision="${MODEL_REVISION}" \
      ai.emmy.target.gpu="NVIDIA Tesla V100 SXM3 32GB" \
      org.opencontainers.image.version="${PUBLISH_VERSION}" \
      org.opencontainers.image.revision="${PUBLISH_REVISION}"
