# syntax=docker/dockerfile:1.7

# Add vLLM's audio extra (librosa, scipy, soundfile, soxr) to an already pinned 1Cat serving image. The
# fork's images install only the CUDA requirements, so an audio model loads but every audio request fails
# to decode the clip ("Please install vllm[audio] for audio support").
#
#   docker build -f Dockerfile.audio \
#     --build-arg BASE_IMAGE=cloudriftai/1cat-vllm-deepseek-v4-flash-0731:1.2.3-d76126608 \
#     -t cloudriftai/1cat-vllm-sm70-audio:1.2.3-d76126608 .

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG BASE_IMAGE
RUN pip install --no-cache-dir \
        librosa==0.11.0 \
        scipy==1.16.2 \
        soundfile==0.13.1 \
        soxr==1.0.0 \
    && python3 -c "import librosa, soundfile, soxr"

LABEL ai.emmy.base-image="${BASE_IMAGE}"
