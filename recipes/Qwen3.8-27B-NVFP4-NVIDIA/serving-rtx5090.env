# The compiler matrix for nvidia/Qwen3.8-27B-NVFP4 on one RTX 5090: one request, text only, a BF16 trunk, the output
# head kept NVFP4. This file names the programs the golden must cover for `emmy trace --serving-twins` and
# `emmy eval golden`; the head program is the twin `head-sym`.
SERVE_MODEL=nvidia/Qwen3.8-27B-NVFP4
SERVE_REVISION=482ca0f3832238542f8f5295dde86b5f22711d80
SERVE_GPU="NVIDIA GeForce RTX 5090"
SERVE_GOLDEN_FILE=recipes/Qwen3.8-27B-NVFP4-NVIDIA/golden/rtx5090_sm120.json
# 64-token prefill chunks: the default 80-token budget also runs an untuned 16-token program every step.
SERVE_MAX_NUM_BATCHED_TOKENS=64
SERVE_DECODE_BUCKET=16
SERVE_PREFILL_BUCKET=64
SERVE_PREFILL_CAPACITY=64
# No width-1 decode tier: the decode bucket serves single-token steps too.
SERVE_M1_TIER=0
# The input embedding table (2.37 GiB) in mapped host memory: 2.36 GiB more KV cache, the same tokens, and no TPOT
# cost on a x16 link (EMMY_GEN_EMBED_HOST).
SERVE_EMBED_HOST=1
# The checkpoint's residual stream is BF16; `--dtype` here sets both the engine's and the twins' data type.
SERVE_EXTRA_ARGS="--dtype bfloat16"
# The fast-math lane: the same widths compiled under EMMY_FAST_MATH=1, which the server runs with.
SERVE_WARM_SHAPES=":::fm"
SERVE_ENV="EMMY_FAST_MATH=1"
