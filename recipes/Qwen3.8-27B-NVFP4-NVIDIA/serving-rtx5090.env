# The compiler matrix for nvidia/Qwen3.8-27B-NVFP4 on one RTX 5090: one request with at most one image, a BF16 trunk,
# the output head kept NVFP4. This file names the programs the golden must cover for `emmy trace --serving-twins` and
# `emmy eval golden`; the head program is the twin `head-sym`, the vision tower's are `tower<tokens>-<piece>`.
SERVE_MODEL=nvidia/Qwen3.8-27B-NVFP4
SERVE_REVISION=482ca0f3832238542f8f5295dde86b5f22711d80
SERVE_GPU="NVIDIA GeForce RTX 5090"
SERVE_GOLDEN_FILE=recipes/Qwen3.8-27B-NVFP4-NVIDIA/golden/rtx5090_sm120.json
# 64-token prefill chunks: the default 80-token budget also runs an untuned 16-token program every step.
SERVE_MAX_NUM_BATCHED_TOKENS=64
SERVE_DECODE_BUCKET=16
SERVE_PREFILL_BUCKET=64
SERVE_PREFILL_CAPACITY=64
# No width-1 decode tier: the decode bucket serves single-token steps too.
SERVE_M1_TIER=0
# No page of the input embedding table (2.37 GiB) on the device: the pager reads every row from host memory, which
# gives 2.36 GiB more KV cache, the same tokens, and no TPOT cost on a x16 link (EMMY_GEN_EMBED_GPU).
SERVE_EMBED_GPU=0
# The checkpoint's residual stream is BF16; `--dtype` here sets both the engine's and the twins' data type. One image
# per prompt, at most 1024 x 1024 (1,024 image tokens, the compiled tower's widest program).
SERVE_EXTRA_ARGS="--dtype bfloat16 --limit-mm-per-prompt '{\"image\":1,\"video\":0}' --mm-processor-kwargs '{\"size\":{\"longest_edge\":1048576,\"shortest_edge\":65536}}'"
# The fast-math lane: the same widths compiled under EMMY_FAST_MATH=1, which the server runs with.
SERVE_WARM_SHAPES=":::fm"
SERVE_ENV="EMMY_FAST_MATH=1"
