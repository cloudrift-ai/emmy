# The compiler matrix and serving shape for RadixArk/Qwen3.8-Flash-Next-NVFP4 on four V100 SXM3 32 GB: the single
# source for the golden's twin widths, which `emmy trace --serving-twins` and `emmy eval golden` read, and for the
# boots that replay it. Same syntax rules as the release configs in docker/vllm-emmy-serve/models/: `VAR=value`, one
# per line, double quotes around any value containing spaces.
#
# The shape is the 1Cat fork's own for this model on the same node, chosen in the fork baseline
# (experiments/Qwen3.8-Flash-Next/fork_baseline_v100_sxm3): tensor parallel 4, a 131,072-token context, 4,096-token
# prefill steps, up to eight sequences, prefix caching, and the key/value pool pinned at 2.5 GiB per card. Every
# layer folds into one twin profile: the fork hosts the sparse attention, the Gated DeltaNet layers and the n-gram PLE,
# and Emmy runs the gated residuals, the router and the experts between them.
SERVE_MODEL=RadixArk/Qwen3.8-Flash-Next-NVFP4
SERVE_REVISION=7b719225242aacd3dbd3f9407468c2ee9a9d2594
SERVE_GOLDEN_FILE=recipes/Qwen3.8-Flash-Next-NVFP4/golden/v100_sm70.json
SERVE_MAX_MODEL_LEN=131072
# 4096 prefill capacity + the 8-row decode bucket.
SERVE_MAX_NUM_BATCHED_TOKENS=4104
SERVE_PREFILL_CAPACITY=4096
SERVE_PREFILL_BUCKET=4096
# 8 = the most sequences one step carries in this shape.
SERVE_DECODE_BUCKET=8
# Off: single-token pre and post steps pad to the 8-row twins. Picked cold, the single-token pre program took 529 ms
# on the V100 against 42 us for torch.compile's, and DeepSeek V4 serves with the tier off for the same reason. The
# single-token EXPERT program is built either way: the fixed-slot tier runs it.
SERVE_M1_TIER=0
SERVE_GPU_MEM_UTIL=0.85
SERVE_GPU="NVIDIA Tesla V100 SXM3 32GB"
# Each of the four ranks holds a quarter of every routed expert, so every decode step up to the bucket rides the
# fixed-slot expert tier and is captured. Prefix caching keeps the Gated DeltaNet and short-convolution states at each
# cached block's end ("align", which the fork's model requires). The rest is the fork baseline's own invocation: the
# pool pinned in bytes, no async scheduling, and the reasoning and tool-call parsers.
SERVE_EXTRA_ARGS="--tensor-parallel-size 4 --dtype float16 --max-num-seqs 8 --kv-cache-memory-bytes 2684354560 --language-model-only --enable-prefix-caching --mamba-cache-mode align --no-async-scheduling --reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder"
SERVE_CAPTURE_SIZES="[1, 2, 4, 8]"
# The fork lays out the sparse attention's ring cache only in its Model Runner V2, and picks that runner by
# architecture name, which Emmy's class does not match.
SERVE_V2_MODEL_RUNNER=1
# The n-gram table goes to pinned host memory whole (12 GiB holds a rank's quarter of its 47.7 GiB), as the fork's own
# lane keeps it. Left to place the table itself, the fork sizes the key/value cache before vLLM widens the attention
# pages to the Gated DeltaNet state, and refuses the pages. Strict evidence: a fork no golden row decides refuses the
# boot instead of serving the prior's pick (cold, the 8-row post program took 545 ms and the 16-row one did not
# finish in 30 minutes).
SERVE_ENV="VLLM_QWEN4EXP_PLE_HOST_GIB=12 EMMY_STRICT_EVIDENCE=1"
# The 1Cat v1.5.1 fork image with its kernel caches baked in, by digest.
SERVE_BASE_IMAGE=cloudriftai/1cat-vllm-qwen3.8-flash-next-nvfp4@sha256:bf976828fc0028aa2f67d2e4e23586e749c7d6ff39a036bc4f97fbbcaccef65b
SERVE_RUNTIME_VERSION=1.5.1
