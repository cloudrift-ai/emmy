# The compiler matrix for Qwen/Qwen3.8-27B on one H100 80GB: text only, BF16 weights and trunk, no quantization.
# This file names the programs the golden must cover, so `emmy trace --serving-twins` and `emmy eval golden` read it.
# Serving itself was not measured on this card: the golden was traced and benched program by program.
SERVE_MODEL=Qwen/Qwen3.8-27B
SERVE_REVISION=1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0
SERVE_GPU="NVIDIA H100 80GB"
SERVE_GOLDEN_FILE=recipes/Qwen3.8-27B/golden/h100_sm90.json
SERVE_MAX_NUM_BATCHED_TOKENS=64
SERVE_DECODE_BUCKET=16
SERVE_PREFILL_BUCKET=64
# No width-1 decode tier: the decode bucket serves single-token steps too.
SERVE_M1_TIER=0
SERVE_EXTRA_ARGS="--dtype bfloat16"
