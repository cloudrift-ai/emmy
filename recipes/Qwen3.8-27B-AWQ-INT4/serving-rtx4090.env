# The compiler matrix for philbert440/Qwen3.8-27B-W4A16-AWQ on one RTX 4090: one request, text only, a BF16 trunk, the
# 4-bit weights kept coded and decoded inside their kernels. This file names the programs the golden must cover, so
# `emmy trace --serving-twins` and `emmy eval golden` read it. The recipe serves stock vLLM; this is compiler evidence.
SERVE_MODEL=philbert440/Qwen3.8-27B-W4A16-AWQ
SERVE_REVISION=7908d42a71077a5e4dc458f273682b12dfe384a0
SERVE_GPU="NVIDIA GeForce RTX 4090"
SERVE_GOLDEN_FILE=recipes/Qwen3.8-27B-AWQ-INT4/golden/rtx4090_sm89.json
SERVE_MAX_NUM_BATCHED_TOKENS=64
SERVE_DECODE_BUCKET=16
SERVE_PREFILL_BUCKET=64
# No width-1 decode tier: the decode bucket serves single-token steps too.
SERVE_M1_TIER=0
SERVE_EXTRA_ARGS="--dtype bfloat16"
