# The compiler matrix for Inferact/Qwen3.8-27B-NVFP4 on one RTX 5090: one request, text only, a BF16 trunk.
# Full-model strict-evidence serving is measured in DISCOVERY.md, including the gated DeltaNet layers.
# This file names the programs the golden must cover for `emmy trace --serving-twins` and `emmy eval golden`.
SERVE_MODEL=Inferact/Qwen3.8-27B-NVFP4
SERVE_REVISION=6128240ebaf4eaa7bad2b3d1c72c37d677c5f462
SERVE_GPU="NVIDIA GeForce RTX 5090"
SERVE_GOLDEN_FILE=recipes/Qwen3.8-27B-NVFP4/golden/rtx5090_sm120.json
SERVE_MAX_NUM_BATCHED_TOKENS=64
SERVE_DECODE_BUCKET=16
SERVE_PREFILL_BUCKET=64
# No width-1 decode tier: the decode bucket serves single-token steps too.
SERVE_M1_TIER=0
# The checkpoint's residual stream is BF16; `--dtype` here sets both the engine's and the twins' data type.
SERVE_EXTRA_ARGS="--dtype bfloat16"
# The fast-math lane: the same widths compiled under EMMY_FAST_MATH=1, which the server runs with.
SERVE_WARM_SHAPES=":::fm"
SERVE_ENV="EMMY_FAST_MATH=1"
