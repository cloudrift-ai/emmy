# A compiler matrix only: Qwen/Qwen3.8-27B-FP8 does not fit one 24 GB RTX 4090 (30.9 GB of FP8 weights), so nothing
# serves it on this card. The card serves the AWQ W4A16 checkpoint, whose coded weights the serving-twin trace does not
# spell yet; these FP8 twins measure the same layers on sm_89 with the FP8 weights kept coded, under a BF16 trunk.
# This file names the programs the golden must cover, so `emmy trace --serving-twins` and `emmy eval golden` read it.
SERVE_MODEL=Qwen/Qwen3.8-27B-FP8
SERVE_REVISION=017b9c7af6b5689d5dd426a76e0bc077eb5ca20a
SERVE_GPU="NVIDIA GeForce RTX 4090"
SERVE_GOLDEN_FILE=recipes/Qwen3.8-27B-FP8/golden/rtx4090_sm89.json
SERVE_MAX_NUM_BATCHED_TOKENS=64
SERVE_DECODE_BUCKET=16
SERVE_PREFILL_BUCKET=64
# No width-1 decode tier: the decode bucket serves single-token steps too.
SERVE_M1_TIER=0
SERVE_EXTRA_ARGS="--dtype bfloat16"
