# The compiler matrix for Qwen/Qwen3.8-27B-FP8 on V100 SXM3 32 GB cards: text only, an FP16 trunk (Volta has no BF16),
# the FP8 weights kept coded and run weight-only. 30.9 GB of FP8 weights do not fit one 32 GB card, so two pipeline
# stages hold the model. This file names the programs the golden must cover, so `emmy trace --serving-twins` and
# `emmy eval golden` read it. It is a compiler matrix: the recipe serves stock 1Cat-vLLM on SXM2 cards.
SERVE_MODEL=Qwen/Qwen3.8-27B-FP8
SERVE_REVISION=017b9c7af6b5689d5dd426a76e0bc077eb5ca20a
SERVE_GPU="NVIDIA Tesla V100 SXM3 32GB"
SERVE_GOLDEN_FILE=recipes/Qwen3.8-27B-FP8/golden/v100_sxm3_sm70.json
SERVE_MAX_NUM_BATCHED_TOKENS=64
SERVE_DECODE_BUCKET=16
SERVE_PREFILL_BUCKET=64
# No width-1 decode tier: the decode bucket serves single-token steps too.
SERVE_M1_TIER=0
# Pipeline stages split the layers and leave every program whole, so the twins do not depend on the stage count.
SERVE_EXTRA_ARGS="--dtype float16 --pipeline-parallel-size 2"
