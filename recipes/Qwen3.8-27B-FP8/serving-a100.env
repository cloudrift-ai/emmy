# The compiler matrix for Qwen/Qwen3.8-27B-FP8 on one A100 40GB: text only, a BF16 trunk, the FP8 weights kept
# coded. This file names the programs the golden must cover, so `emmy trace --serving-twins` and `emmy eval golden`
# read it. Serving itself was not measured on this card, and the recipe puts the minimum to serve near 40.2 GB, above
# what this card holds: the golden was traced and benched program by program.
SERVE_MODEL=Qwen/Qwen3.8-27B-FP8
SERVE_REVISION=017b9c7af6b5689d5dd426a76e0bc077eb5ca20a
SERVE_GPU="NVIDIA A100 40GB"
SERVE_GOLDEN_FILE=recipes/Qwen3.8-27B-FP8/golden/a100_sm80.json
SERVE_MAX_NUM_BATCHED_TOKENS=64
SERVE_DECODE_BUCKET=16
SERVE_PREFILL_BUCKET=64
# No width-1 decode tier: the decode bucket serves single-token steps too.
SERVE_M1_TIER=0
SERVE_EXTRA_ARGS="--dtype bfloat16"
